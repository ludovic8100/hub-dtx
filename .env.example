# ───────────────────────────────────────────────────────────────────────────────
# Hub DTX — variables d'environnement (copier en `.env.local` pour le développement ;
# sur Vercel : Settings → Environment Variables, par cible Production / Preview).
# Aucune valeur ici n'est un secret. Sans variable, le Hub pointe sur la PRODUCTION.
# ───────────────────────────────────────────────────────────────────────────────

# ── Environnement ──
# production (défaut) | test. En `test`, les URL/clés Supabase deviennent OBLIGATOIRES
# et un bandeau « ENVIRONNEMENT DE TEST » s'affiche dans le Hub.
VITE_APP_ENV=production
APP_ENV=production

# ── Supabase (front : VITE_* ; api/ : sans préfixe, les VITE_* sont acceptées en repli) ──
VITE_SUPABASE_URL=https://tndwonqdbeszkcztkzqe.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xBt6ZaZGh5trEloyMCNRuA_MN-jesVJ
SUPABASE_URL=https://tndwonqdbeszkcztkzqe.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xBt6ZaZGh5trEloyMCNRuA_MN-jesVJ
# Clé service_role : UNIQUEMENT côté serveur (api/, GitHub Secrets). Jamais dans VITE_*.
# SUPABASE_SERVICE_KEY=

# ── n8n ──
VITE_N8N_URL=https://n8n.srv1082740.hstgr.cloud
N8N_URL=https://n8n.srv1082740.hstgr.cloud

# ── SharePoint (source de vérité des documents) ──
VITE_SHAREPOINT_SITE=https://dynassur.sharepoint.com/sites/ADMINISTRATION
VITE_SHAREPOINT_ROOT=Documents partages
SHAREPOINT_SITE=https://dynassur.sharepoint.com/sites/ADMINISTRATION
SHAREPOINT_ROOT=Documents partages
# En test : SHAREPOINT_ROOT=Documents partages/_TEST (défaut automatique si APP_ENV=test)

# ── Hub ──
VITE_HUB_URL=https://hub-dtx.vercel.app
HUB_URL=https://hub-dtx.vercel.app

# ── Microsoft Graph (api/ uniquement — secrets Vercel) ──
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# En test : redirige tout mail sortant vers cette adresse (préfixe [TEST])
# MAIL_REDIRECT_TO=lde@dynassur.be

# ── GitHub (api/reload-qlik : relance de l'Action qlik-sync) ──
# GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=ludovic8100/hub-dtx
# Branche visée par les Actions : main en prod, staging en test (défaut automatique)
# GITHUB_SYNC_REF=main
